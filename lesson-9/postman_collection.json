		{
			"name": "[Work] Create order",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code is 201\", function () {\r",
							"    pm.expect(pm.response.code).to.eql(201);\r",
							"});\r",
							"\r",
							"\r",
							"//pm.test(\"Response Content-Type is application/json\", function () {\r",
							"//    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r",
							"//});\r",
							"\r",
							"pm.test(\"Validate the schema of the response\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData).to.have.all.keys('warehouse_list', 'user_id', 'idempotency', 'amount', 'order_id');\r",
							"\r",
							"    pm.expect(responseData.warehouse_list).to.be.an('array');\r",
							"    responseData.warehouse_list.forEach(function(warehouse) {\r",
							"        pm.expect(warehouse).to.be.an('object');\r",
							"        pm.expect(warehouse).to.have.all.keys('warehouse_id', 'name', 'price', 'count');\r",
							"        pm.expect(warehouse.warehouse_id).to.be.a('number');\r",
							"        pm.expect(warehouse.name).to.be.a('string');\r",
							"        pm.expect(warehouse.price).to.be.a('number');\r",
							"        pm.expect(warehouse.count).to.be.a('number');\r",
							"    });\r",
							"\r",
							"    pm.expect(responseData.user_id).to.be.a('number');\r",
							"    pm.expect(responseData.idempotency).to.be.a('string');\r",
							"    pm.expect(responseData.amount).to.be.a('number');\r",
							"    pm.expect(responseData.order_id).to.be.a('number');\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"User ID is a non-negative integer\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.user_id).to.be.a('number').and.to.be.at.least(0);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Warehouse list contains at least one warehouse with required fields\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.warehouse_list).to.be.an('array').that.is.not.empty;\r",
							"\r",
							"    responseData.warehouse_list.forEach(warehouse => {\r",
							"        pm.expect(warehouse).to.have.all.keys('warehouse_id', 'name', 'price', 'count');\r",
							"        pm.expect(warehouse.warehouse_id).to.be.a('number');\r",
							"        pm.expect(warehouse.name).to.be.a('string').that.is.not.empty;\r",
							"        pm.expect(warehouse.price).to.be.a('number');\r",
							"        pm.expect(warehouse.count).to.be.a('number');\r",
							"    });\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
